# 複製成 .env 後填入自己的值：cp .env.example .env
# .env 已在 .gitignore,不會進版控。

# ── 對外網址 ────────────────────────────────────────────────
# 報表/地圖連結、LINE webhook 都用這個網址。必填(docker-compose 沒填會直接報錯)
BASE_URL=https://your-domain.example.com
# ngrok 保留域名(給 money-tunnel 容器用),含 https://
NGROK_DOMAIN=https://your-domain.ngrok-free.dev
NGROK_AUTHTOKEN=

# ── 資料庫 ──────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@db:5432/money_db
# 選填:覆蓋 db 容器的帳密。注意 postgres 只在 volume 首次初始化時套用,
# 之後改這裡不會改到既有 DB(要 ALTER USER + 同步改 DATABASE_URL)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=money_db

# ── LINE Bot ────────────────────────────────────────────────
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ── AI ──────────────────────────────────────────────────────
# Gemini:影像辨識(拍照記帳、發票 CAPTCHA)與角色即時評論
GEMINI_API_KEY=
MODEL_NAME=gemini-2.5-flash
# codex CLI:純文字生成(帳目分類、週/月報評語)。留空=用 ~/.codex 的預設模型
CODEX_MODEL=

# ── Discord ─────────────────────────────────────────────────
# 全部選填;沒有 DISCORD_BOT_TOKEN 就整個跳過 Discord Bot
DISCORD_BOT_TOKEN=
DISCORD_RECORD_CHANNEL_ID=      # 圖片記帳頻道;未設則退回「任意頻道圖片記帳」
DISCORD_REPORT_CHANNEL_ID=      # 週報/月結推播
DISCORD_INVOICE_CHANNEL_ID=     # 發票同步通知
FOOD_INGEST_CHANNEL_ID=         # 美食輸入(截圖/文字/連結自動記店)
RECIPE_INGEST_CHANNEL_ID=       # 食譜收錄;未設則食譜分支不啟用
HISTORY_VIDEO_INGEST_CHANNEL_ID= # 歷史教學影片;未設則影片分支不啟用

# ── Google Maps / Places(美食地圖) ─────────────────────────
GOOGLE_PLACES_SERVER_KEY=       # 後端 Places API (New):店名正規化、評論摘要
GOOGLE_MAPS_BROWSER_KEY=        # 前端 Maps JS;建議限制 referrer
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID  # AdvancedMarker 必需;沒申請填 DEMO_MAP_ID(有浮水印)

# ── 財政部電子發票(選填,不填則發票同步不啟用) ──────────────
# ⚠️ 僅用於存取「本人載具」的發票資料
EINVOICE_PHONE_1=
EINVOICE_PASSWORD_1=
EINVOICE_PHONE_2=
EINVOICE_PASSWORD_2=

# ── 其他 ────────────────────────────────────────────────────
MONTHLY_BUDGET=0                # 月度預算;0 或不設=月報不顯示預算進度
