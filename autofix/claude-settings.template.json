{
  "disableAllHooks": true,
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Skill",
      "TodoWrite",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(__AF__/bin/test)",
      "Bash(__AF__/bin/probe:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Edit(autofix/**)",
      "Edit(frontend/**)",
      "Edit(scripts/systemd/**)",
      "Edit(Dockerfile)",
      "Edit(docker-compose.yml)",
      "Edit(.env*)",
      "Bash(docker:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git rebase:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "WebFetch",
      "WebSearch",
      "AskUserQuestion",
      "Bash(rtk docker:*)",
      "Bash(rtk proxy:*)",
      "Bash(rtk git push:*)",
      "Bash(rtk git merge:*)",
      "Bash(rtk git reset:*)",
      "Bash(rtk git checkout:*)",
      "Bash(rtk curl:*)",
      "Bash(rtk wget:*)"
    ]
  }
}
